# Copy this file to .env for local development and fill in real values.
# NEVER commit the real .env file -- it is already excluded in .gitignore.
# In production, set these as secrets in your deployment platform instead
# of using a .env file at all (see README.md).

# Required. Get a free trial key at https://dashboard.cohere.com/api-keys
COHERE_API_KEY=your_cohere_api_key_here

# Optional overrides -- sensible defaults are used if omitted.
# COHERE_EMBED_MODEL=embed-english-v3.0
# COHERE_CHAT_MODEL=command-r-08-2024
# COHERE_RERANK_MODEL=rerank-v3.5
# RETRIEVAL_CANDIDATE_POOL=20
# RETRIEVAL_TOP_K=5
# VECTOR_SIM_THRESHOLD=30.0
# BM25_SCORE_THRESHOLD=1.0
# RERANK_SCORE_THRESHOLD=0.15
# CHROMA_PERSIST_DIR=chroma_db
# CHROMA_COLLECTION=career_knowledge_base
# RAG_TRACE_LOG=logs/traces.jsonl
